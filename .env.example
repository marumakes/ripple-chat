# Copy this file to .env and fill in your Supabase project values.
# Find these in your Supabase dashboard → Project Settings → API.

# The project URL (safe to expose — used to identify the project)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/public key (safe to expose — scoped by RLS policies)
VITE_SUPABASE_ANON_KEY=your-anon-key

# The service role key (NEVER expose this in client-side code or commit it)
# Only needed for server-side scripts that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
